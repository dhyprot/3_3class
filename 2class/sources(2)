def proj(dw,dh, src, a):

 im=np.zeros((dh,dw,3),'f')

 y ,x =np.mgrid[0:dh,0:dw]                   # (i)

 # z_を追加-----
 x_,y_,z_= a[0,0]*x+a[0,1]*y+a[0,2], \
        a[1,0]*x+a[1,1]*y+a[1,2], \
        a[2,0]*x+a[2,1]*y+a[2,2]

 # z_を追加-----
 u,v=x_ / z_, \
    y_ / z_

 m = (0<=u)&(u<src.shape[1])&(0<=v)&(v<src.shape[0]) # (iv)
 # 画像内の座標しか参照しないため，画像を拡大できる

 im[y[m],x[m]]= src[v[m].astype('i'),
		    u[m].astype('i')]        # (iii) int型でやっている

 return im







def afn2(dw,dh, src, a):

# 下記(i) の x,y は
# 下記(ii) で代入する領域の座標そのものであり，
#  x,y = dx+550,dy+220 である．

# afn と同じ出力画像が得られるように
# （u,v を dx,dy ではなく x,y から計算するように），
# main で以下の積を計算し afn2 には積を渡すべき．
# a = a @ np.array([[1,0,-550],
#                   [0,1,-220],
#                   [0,0,1]])

 im=np.zeros((dh,dw,3),'f')

 y ,x =np.mgrid[70:370,400:700]                # (i) 画像の範囲
# 射影変換
 x_,y_= a[0,0]*x+a[0,1]*y+a[0,2], \
        a[1,0]*x+a[1,1]*y+a[1,2]

# zで割っていないかzを反映できてない
 u ,v =x_,y_

 im[y,x]= src[v.astype('i'),                   # (ii)
              u.astype('i')]

 return im












def afn3(dw,dh, src, a):

 # (iv)  で u,v が src の中か外かを判定し，
 # (iii) で u,v が src の内部の場合のみ im[y,x] に代入
 # これにより，(i) 画像全体を処理可能になる
 # (前回の「注意: 値によってはエラーになる」という制約がなくなる)

 im=np.zeros((dh,dw,3),'f')

 y ,x =np.mgrid[0:dh,0:dw]                   # (i)

 x_,y_= a[0,0]*x+a[0,1]*y+a[0,2], \
        a[1,0]*x+a[1,1]*y+a[1,2]
 u,v=x_,y_

 m = (0<=u)&(u<src.shape[1])&(0<=v)&(v<src.shape[0]) # (iv)
 # 画像内の座標しか参照しないため，画像を拡大できる

 im[y[m],x[m]]= src[v[m].astype('i'),
		    u[m].astype('i')]        # (iii) int型でやっている

 return im








def afn4(dw,dh, src, a):

 # 双線形（bilinear）補間
 # (iii) で u,v の小数部分を捨てずに使う．
 # この時に src[u+1,v+1] も参照するため，
 #  (iv) の条件を変更している．

 im=np.zeros((dh,dw,3),'f')

 y ,x =np.mgrid[0:dh,0:dw]

 x_,y_= a[0,0]*x+a[0,1]*y+a[0,2], \
        a[1,0]*x+a[1,1]*y+a[1,2]
 u,v=x_,y_

 m = (0<=u)&(u+1<src.shape[1])&(0<=v)&(v+1<src.shape[0]) # (iv)

 ium=np.floor(u[m]); fum=(u[m]-ium)[...,None]; ium=ium.astype('i')
 ivm=np.floor(v[m]); fvm=(v[m]-ivm)[...,None]; ivm=ivm.astype('i')
 im[y[m],x[m]]= src[ivm  ,ium  ]*(1-fum)*(1-fvm)+ \
	        src[ivm+1,ium  ]*(1-fum)*(  fvm)+ \
	        src[ivm  ,ium+1]*(  fum)*(1-fvm)+ \
	        src[ivm+1,ium+1]*(  fum)*(  fvm)    # (iii)

 return im
